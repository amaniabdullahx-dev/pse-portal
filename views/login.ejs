<%- include('partials/head', { title: 'Candidate Login' }) %>
<%- include('partials/site-header') %>

<div class="form-page" style="max-width:440px;">
  <h1>Candidate Login</h1>
  <p class="lead">Check the status of your application.</p>

  <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <form action="/login" method="POST">
    <div class="field">
      <label>Email</label>
      <input type="email" name="email" required>
    </div>
    <div class="field">
      <label>Password</label>
      <input type="password" name="password" required>
    </div>
    <div class="form-actions">
      <button class="btn btn-black" type="submit" style="border:none;font-family:inherit;cursor:pointer;">Log In</button>
    </div>
    <p class="form-note">No account yet? <a href="/apply" style="text-decoration:underline;">Apply as a candidate</a>.</p>
  </form>
</div>

<%- include('partials/site-footer') %>
