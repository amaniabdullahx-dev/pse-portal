<%- include('partials/head', { title: 'Hire With PSE' }) %>
<%- include('partials/site-header') %>

<section>
  <div class="wrap">
    <div class="eyebrow-dark">Service Models</div>
    <h2 class="section-title">How PSE engages with clients.</h2>
    <div class="grid-3">
      <div class="card">
        <h3>Strategic Executive Search</h3>
        <p>High-level retained advisory for C-suite and director roles, requiring extreme discretion and access to the rarest female leadership talent.</p>
      </div>
      <div class="card">
        <h3>Contract Staffing Advisory</h3>
        <p>Rapid supply of specialized Saudi female talent for fixed-term projects or immediate operational capacity injection.</p>
      </div>
      <div class="card">
        <h3>Permanent Placement Advisory</h3>
        <p>Sourcing candidates for long-term, direct employment within the client's organizational structure.</p>
      </div>
    </div>
  </div>
</section>

<section class="alt">
  <div class="wrap">
    <div class="eyebrow-dark">Risk Mitigation</div>
    <div class="grid-3">
      <div class="card">
        <h3>Placement Guarantee</h3>
        <p>A free replacement search if the hired candidate resigns or is terminated for performance reasons within the agreed guarantee period.</p>
      </div>
      <div class="card">
        <h3>Focus on Value</h3>
        <p>Compliance with qualitative localization goals — never placing an unqualified candidate in a strategic role just to meet a quota.</p>
      </div>
      <div class="card">
        <h3>Built to Last</h3>
        <p>A lean operating model built for long-term stability, so our commitment to your mandate doesn't depend on deal volume.</p>
      </div>
    </div>
  </div>
</section>

<section class="dark">
  <div class="wrap">
    <div class="eyebrow-dark" style="color:#7FE6B8;">Our Service Standard</div>
    <div class="stats">
      <div><div class="stat-num">14</div><div class="stat-label">Working days to first qualified shortlist</div></div>
      <div><div class="stat-num">Top 3</div><div class="stat-label">Technically proficient candidates, guaranteed</div></div>
      <div><div class="stat-num">90</div><div class="stat-label">Day replacement guarantee window</div></div>
    </div>
    <p class="form-note" style="color:#9AA0AA;margin-top:14px;">Operating commitments for every engagement — not historical claims. PSE is a newly registered advisory boutique in the Kingdom.</p>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="eyebrow-dark">The PSE Differentiator</div>
    <div class="grid-3">
      <div class="card">
        <h3>Deep Technical Assessment</h3>
        <p>We move beyond CV filtering. Candidates are pre-vetted against industry-specific technical criteria to ensure immediate operational capability from day one.</p>
      </div>
      <div class="card">
        <h3>Vision 2030 Alignment Scoring</h3>
        <p>We evaluate experience in Giga-Projects or direct contribution to national KPIs, ensuring candidates meet the qualitative standards of the localization mandate.</p>
      </div>
      <div class="card">
        <h3>Speed in Scarcity</h3>
        <p>Continuous, focused talent pool mapping lets us generate a viable, vetted shortlist faster than generalist firms starting from scratch for niche requests.</p>
      </div>
    </div>
  </div>
</section>

<div class="form-page">
  <% if (sent) { %>
    <h1>Thank you.</h1>
    <p class="lead">Your request has been received. A member of the PSE team will reach out to you shortly to discuss your mandate.</p>
    <div class="form-actions">
      <a class="btn btn-black" href="/">Back to Home</a>
    </div>
  <% } else { %>
    <h1>Hire With PSE</h1>
    <p class="lead">Tell us who you are and how to reach you — we'll follow up to understand your mandate and how PSE can help.</p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form action="/hire" method="POST">
      <div class="field">
        <label>Organization / Entity Name</label>
        <input type="text" name="organization_name" required placeholder="e.g. NEOM, ACWA Power, PIF subsidiary…" value="<%= old.organization_name || '' %>">
      </div>

      <div class="field">
        <label>Phone Number</label>
        <input type="tel" name="phone" required placeholder="+966 5X XXX XXXX" value="<%= old.phone || '' %>">
      </div>

      <div class="field">
        <label>Your Name (optional)</label>
        <input type="text" name="contact_name" value="<%= old.contact_name || '' %>">
      </div>

      <div class="field">
        <label>Tell us about your mandate (optional)</label>
        <textarea name="message" placeholder="Role, seniority, timeline — anything that helps us prepare."><%= old.message || '' %></textarea>
      </div>

      <div class="form-actions">
        <button class="btn btn-black" type="submit" style="border:none;font-family:inherit;cursor:pointer;">Send Request</button>
      </div>
      <p class="form-note">We'll reach out within one business day.</p>
    </form>
  <% } %>
</div>

<%- include('partials/site-footer') %>
