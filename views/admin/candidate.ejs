<%- include('../partials/head', { title: candidate.full_name }) %>
<%- include('../partials/admin-header', { heading: candidate.full_name }) %>

<section>
  <div class="wrap" style="max-width:820px;">
    <% if (typeof saved !== 'undefined' && saved) { %><div class="alert alert-success">Changes saved.</div><% } %>

    <p style="margin-bottom:24px;"><span class="status-badge status-<%= candidate.status %>"><%= candidate.status %></span></p>

    <div class="detail-grid">
      <div><div class="k">Email</div><div class="v"><a href="mailto:<%= candidate.email %>"><%= candidate.email %></a></div></div>
      <div><div class="k">Phone</div><div class="v"><%= candidate.phone %></div></div>
      <div><div class="k">Specialization</div><div class="v"><%= candidate.specialization %></div></div>
      <div><div class="k">Experience</div><div class="v"><%= candidate.years_experience %></div></div>
      <div><div class="k">Applied</div><div class="v"><%= candidate.created_at %></div></div>
      <div><div class="k">CV</div><div class="v"><a href="/admin/candidate/<%= candidate.id %>/cv" style="text-decoration:underline;">Download <%= candidate.cv_original_name %></a></div></div>
    </div>

    <% if (candidate.giga_project_experience) { %>
      <div style="margin:24px 0;">
        <div class="k" style="margin-bottom:6px;">Vision 2030 / Giga-Project Experience</div>
        <p style="background:#F5F5F5;padding:16px;border-radius:6px;"><%= candidate.giga_project_experience %></p>
      </div>
    <% } %>

    <div class="ai-card">
      <div style="display:flex;justify-content:space-between;align-items:center;">
        <h3 style="margin:0;">AI Screening</h3>
        <form method="POST" action="/admin/candidate/<%= candidate.id %>/analyze"><button class="btn" style="cursor:pointer;font-family:inherit;border:1px solid #ccc;background:#fff;"><%= report ? 'Re-analyze' : 'Analyze CV' %></button></form>
      </div>
      <% if (candidate.ai_status === 'running') { %><p class="muted">Analysis in progress — refresh in a minute.</p><% } %>
      <% if (candidate.ai_status === 'error') { %><p style="color:#9A2A2A;">Failed: <%= candidate.ai_error %></p><% } %>
      <% if (report) { %>
        <p style="margin:12px 0;"><strong style="font-size:26px;"><%= report.total %></strong>/100 <span class="tier tier-<%= report.tier %>"><%= report.tier %></span></p>
        <p><%= report.summary %></p>
        <% RUBRIC.forEach(function(k){ var s = report.scores[k.key]; %>
          <div style="margin:10px 0;"><div style="display:flex;justify-content:space-between;font-size:13px;"><span><%= k.label %></span><span><%= s.points %>/<%= k.max %></span></div>
          <div class="bar"><i style="width:<%= Math.round(s.points / k.max * 100) %>%"></i></div><div class="muted"><%= s.why %></div></div>
        <% }) %>
        <% if (report.strengths && report.strengths.length) { %><p><strong>Strengths:</strong> <%= report.strengths.join(' · ') %></p><% } %>
        <% if (report.gaps && report.gaps.length) { %><p><strong>Gaps:</strong> <%= report.gaps.join(' · ') %></p><% } %>
        <% if (report.red_flags && report.red_flags.length) { %><p style="color:#9A2A2A;"><strong>Check:</strong> <%= report.red_flags.join(' · ') %></p><% } %>
        <% if (report.interview_questions && report.interview_questions.length) { %><p><strong>Suggested interview questions:</strong></p><ul><% report.interview_questions.forEach(function(q){ %><li><%= q %></li><% }) %></ul><% } %>
        <p class="muted"><strong>Eligibility (verify manually, not scored):</strong> <%= report.eligibility_notes %></p>
        <p class="muted">Recommendation only. Final decision is yours.</p>
      <% } %>
    </div>

    <form action="/admin/candidate/<%= candidate.id %>" method="POST" style="margin-top:36px;border-top:1px solid #E4E4E4;padding-top:30px;">
      <div class="form-row">
        <div class="field">
          <label>Update Status</label>
          <select name="status">
            <% ['New','Shortlisted','Interview','Placed','Rejected'].forEach(function(s){ %>
              <option value="<%= s %>" <%= candidate.status === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="field">
        <label>Internal Notes (not visible to candidate)</label>
        <textarea name="admin_notes"><%= candidate.admin_notes || '' %></textarea>
      </div>
      <div class="form-actions">
        <button class="btn btn-black" type="submit" style="border:none;cursor:pointer;font-family:inherit;">Save Changes</button>
      </div>
    </form>
  </div>
</section>

</body>
</html>
