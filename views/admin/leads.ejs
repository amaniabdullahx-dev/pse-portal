<%- include('../partials/head', { title: 'Client Leads' }) %>

<div class="dash-header">
  <div class="wrap">
    <div>
      <div style="color:#9AA0AA;font-size:12px;letter-spacing:2px;text-transform:uppercase;margin-bottom:8px;">PSE Admin</div>
      <h1 style="color:#fff;font-size:26px;">Client Leads</h1>
    </div>
    <div>
      <a href="/admin/dashboard" style="color:#9AA0AA;font-size:13px;margin-right:20px;">Candidates</a>
      <a href="/admin/logout" style="color:#9AA0AA;font-size:13px;">Log out</a>
    </div>
  </div>
</div>

<section>
  <div class="wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Organization</th>
          <th>Phone</th>
          <th>Contact Name</th>
          <th>Message</th>
          <th>Status</th>
          <th>Received</th>
        </tr>
      </thead>
      <tbody>
        <% leads.forEach(function(l) { %>
          <tr>
            <td><strong><%= l.organization_name %></strong></td>
            <td><a href="tel:<%= l.phone %>"><%= l.phone %></a></td>
            <td><%= l.contact_name || '—' %></td>
            <td style="max-width:280px;color:#6B6F76;font-size:13px;"><%= l.message || '—' %></td>
            <td>
              <form method="POST" action="/admin/leads/<%= l.id %>" style="display:inline;">
                <select name="status" onchange="this.form.submit()" style="padding:6px 10px;border:1px solid var(--border);border-radius:8px;font-family:'Lato';font-size:12.5px;">
                  <% ['New','Contacted','In Discussion','Closed'].forEach(function(s){ %>
                    <option value="<%= s %>" <%= l.status === s ? 'selected' : '' %>><%= s %></option>
                  <% }) %>
                </select>
              </form>
            </td>
            <td><%= l.created_at.split(' ')[0] %></td>
          </tr>
        <% }) %>
        <% if (leads.length === 0) { %>
          <tr><td colspan="6" style="text-align:center;color:#9A9A9A;padding:40px 0;">No client requests yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

</body>
</html>
