<%- include('partials/head', { title: 'Home' }) %>
<%- include('partials/site-header') %>

<!-- ============================================================
     SLIDE 01 — WHO WE ARE  (hero, not pinned — content-rich)
     ============================================================ -->
<section class="slide slide-flow slide-dark" id="who-we-are">
  <div class="story-bg" style="background-image:url('/img/story/story-01-group.jpg');"></div>
  <div class="story-overlay"></div>
  <div class="slide-content wrap">
    <div class="heritage-tag line"><span>Formerly SustainHer — Empowering Women in Saudi Arabia's Energy &amp; Sustainable Sectors</span></div>
    <div class="story-index"><span class="line"><span>01 — Who We Are</span></span></div>
    <h1 class="story-title"><span class="line"><span>Connecting Saudi Arabia's specialized female talent — in engineering and economics — to the roles that need them most.</span></span></h1>
    <p class="story-text"><span class="line"><span>Pillars for Sustainable Empowerment (PSE) began as SustainHer, a research initiative on women's participation in Saudi Arabia's energy and sustainability sectors. Today, PSE is a specialized management consulting boutique placing rigorously vetted Saudi female professionals — with deep expertise in engineering and economics — into the Vision 2030 entities, Giga-Projects, and PIF subsidiaries building the Kingdom's future.</span></span></p>

    <div class="v2030-badge line"><span>Aligned with Saudi Vision 2030</span></div>

    <div class="split-cta line">
      <span>
        <a class="split-card for-clients" href="/hire">
          <span class="split-card-icon"><%- include('partials/icon', { name: 'briefcase' }) %></span>
          <span class="split-card-title">For Clients</span>
          <span class="split-card-text">Hiring for a critical Vision 2030 role? Tell us who you are and how to reach you.</span>
          <span class="split-card-link">Hire With PSE →</span>
        </a>
        <a class="split-card for-candidates" href="/apply">
          <span class="split-card-icon"><%- include('partials/icon', { name: 'users' }) %></span>
          <span class="split-card-title">For Candidates</span>
          <span class="split-card-text">A specialized Saudi professional? Submit your profile for review.</span>
          <span class="split-card-link">Apply as a Candidate →</span>
        </a>
      </span>
    </div>
  </div>
</section>

