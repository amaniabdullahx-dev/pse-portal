<!-- ============================================================
     HERO
     ============================================================ -->
<section class="slide slide-flow slide-dark" id="vision-hero">
  <div class="story-overlay-mesh"></div>
  <div class="slide-content wrap">
    <div class="story-index"><span class="line"><span>Pillars for Sustainable Empowerment</span></span></div>
    <h1 class="story-title"><span class="line"><span>SustainHer</span></span></h1>
    <p class="story-text"><span class="line"><span>Empowering Women in Saudi Arabia's Energy &amp; Sustainable Sectors</span></span></p>
    <p class="story-text" style="margin-top:18px;"><span class="line"><span>A live platform for Saudi Arabia's most specialized female talent — built, operating, and ready to scale nationally.</span></span></p>
  </div>
</section>

<!-- ============================================================
     OUR ORIGIN
     ============================================================ -->
<section class="slide slide-flow slide-dark" id="vision-origin">
  <div class="story-bg" style="background-image:url('/img/story/story-02-reach.jpg');"></div>
  <div class="story-overlay story-overlay-heavy"></div>
  <div class="slide-content wrap">
    <div class="story-index reveal"><span class="line"><span>Our Origin</span></span></div>
    <h2 class="story-title reveal"><span class="line"><span>From a research initiative to a live operating platform.</span></span></h2>
    <p class="story-text reveal"><span class="line"><span>Pillars for Sustainable Empowerment (PSE) began as SustainHer, a research initiative on women's participation in Saudi Arabia's energy and sustainability sectors. That research became the foundation for a live operating platform: Pillars for Sustainable Empowerment (PSE), a specialized management consulting boutique placing Saudi female professionals — with deep expertise in engineering and economics — into Vision 2030 entities, Giga-Projects, and PIF subsidiaries.</span></span></p>
    <div class="v2030-badge reveal"><span>Aligned with Saudi Vision 2030</span></div>
  </div>
</section>

<!-- ============================================================
     FOR CLIENTS / FOR CANDIDATES
     ============================================================ -->
<section class="slide slide-flow slide-dark" id="vision-cta">
  <div class="story-overlay-mesh"></div>
  <div class="slide-content wrap">
    <div class="split-cta reveal">
      <span>
        <a class="split-card for-clients" href="/hire">
          <span class="split-card-icon"><%- include('partials/icon', { name: 'briefcase' }) %></span>
          <span class="split-card-title">For Clients</span>
          <span class="split-card-text">Hiring for a critical Vision 2030 role? Tell us who you are and how to reach you.</span>
          <span class="split-card-link">Hire With PSE →</span>
        </a>
        <a class="split-card for-candidates" href="/apply">
          <span class="split-card-icon"><%- include('partials/icon', { name: 'users' }) %></span>
          <span class="split-card-title">For Candidates</span>
          <span class="split-card-text">A specialized Saudi professional? Submit your profile for review.</span>
          <span class="split-card-link">Apply as a Candidate →</span>
        </a>
      </span>
    </div>
  </div>
</section>

<!-- ============================================================
     OUR VISION / MISSION
     ============================================================ -->
<section class="slide slide-flow slide-dark" id="vision-mission">
  <div class="story-bg" style="background-image:url('/img/story/story-03-stairs.jpg');"></div>
  <div class="story-overlay story-overlay-heavy"></div>
  <div class="slide-content wrap">
    <div class="vm-split reveal">
      <div class="vm-card-dark">
        <span class="icon-badge"><%- include('partials/icon', { name: 'eye' }) %></span>
        <h3>Our Vision</h3>
        <p>To be the Kingdom's indispensable partner in qualitative national localization — connecting the top tier of specialized Saudi female professionals to roles that carry real technical and strategic weight.</p>
      </div>
      <div class="vm-card-dark">
        <span class="icon-badge"><%- include('partials/icon', { name: 'target' }) %></span>
        <h3>Our Mission</h3>
        <p>We use structured technical and psychometric assessment to help Vision 2030 organizations identify, place, and retain specialized Saudi female talent — with evidence, not guesswork.</p>
      </div>
    </div>
  </div>
</section>

